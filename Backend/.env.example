# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/food_delivery

# Authentication
JWT_SECRET=super_secret_jwt_cravebite_food_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# OTP Configuration
OTP_MODE=development
OTP_TTL_MINUTES=5
OTP_DEV_LOG_ENABLED=true
MAX_OTP_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# Order Status Simulation (development only)
SIMULATE_ORDER_STATUS=false
SIMULATION_INTERVAL_MS=8000

# Optional External SMS Provider (Twilio / AWS SNS / etc.)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
